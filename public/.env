# KostKita Public Tenant Portal - Environment Configuration

# URL Backend API (Untuk development lokal dengan Vite proxy, cukup gunakan /api/v1/public)
# Jika ingin direct tanpa proxy atau untuk production, gunakan full URL misalnya: http://localhost:3000/api/v1/public
VITE_API_BASE_URL=/api/v1/public

# Metadata Aplikasi
VITE_APP_NAME=KostKita
VITE_APP_TAGLINE="Platform Sewa & Manajemen Kost Modern"

# Default Koordinat Peta (Padang / Unand)
VITE_DEFAULT_MAP_LAT=-0.9242
VITE_DEFAULT_MAP_LNG=100.3831
VITE_DEFAULT_MAP_ZOOM=13
