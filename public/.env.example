# KostKita Public Tenant Portal - Environment Configuration Template
# Salin file ini menjadi .env jika ingin mengubah konfigurasi:
# cp .env.example .env

# Base URL API Backend (Bisa gunakan relative path /api/v1/public jika menggunakan proxy Vite, atau full URL)
VITE_API_BASE_URL=/api/v1/public

# Metadata
VITE_APP_NAME=KostKita
VITE_APP_TAGLINE="Platform Sewa & Manajemen Kost Modern"

# Default Koordinat Peta Leaflet
VITE_DEFAULT_MAP_LAT=-0.9242
VITE_DEFAULT_MAP_LNG=100.3831
VITE_DEFAULT_MAP_ZOOM=13
